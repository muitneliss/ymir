#!/bin/sh
# Ymir wiki CLI — repo-local resolver. Generated by `wiki init`; commit it.
#
# `wiki/SCHEMA.md` is a tracked file, so the invocation it documents has to work
# in every checkout. Naming the absolute path of the binary that scaffolded the
# wiki does not: that path encodes both the machine and the install layout
# (skill root on one, plugin cache on another), so the line resolves for exactly
# one person. This shim is what SCHEMA.md names instead — it finds the binary at
# run time and hands off to it.
#
# Set YMIR_WIKI_BIN to a path to override the search entirely.
set -u

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
self="$self_dir/$(basename -- "$0")"
project_root=$(CDPATH= cd -- "$self_dir/../.." && pwd -P) || project_root="$self_dir"

# Compare physical paths, so `./wiki/bin/wiki` found on PATH is recognised as
# this very script rather than executed as a child of itself forever.
physical() {
  _dir=$(CDPATH= cd -- "$(dirname -- "$1")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$_dir" "$(basename -- "$1")"
}

# `sort -V` is not POSIX; without it 0.10.0 would lose to 0.9.0, so fall back to
# plain descending order rather than picking a wrong "newest".
version_desc() {
  if printf '0.1.0\n' | sort -V >/dev/null 2>&1; then sort -Vr; else sort -r; fi
}

candidates() {
  if [ -n "${YMIR_WIKI_BIN:-}" ]; then printf '%s\n' "$YMIR_WIKI_BIN"; fi
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then printf '%s\n' "$CLAUDE_PLUGIN_ROOT/wiki-cli/bin/wiki"; fi
  printf '%s\n' "$project_root/.claude/skills/ymir/wiki-cli/bin/wiki"
  if [ -n "${HOME:-}" ]; then
    printf '%s\n' "$HOME/.claude/skills/ymir/wiki-cli/bin/wiki"
    ls -d "$HOME"/.claude/plugins/cache/ymir/ymir/*/wiki-cli/bin/wiki 2>/dev/null | version_desc
  fi
  # PATH last: other tools are also called `wiki`, so the known Ymir layouts win.
  command -v wiki 2>/dev/null
}

found=""
searched=""
candidate_list=$(candidates)

if [ -n "$candidate_list" ]; then
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    searched="$searched
  $candidate"
    [ -n "$found" ] && continue
    [ -f "$candidate" ] && [ -x "$candidate" ] || continue
    resolved=$(physical "$candidate") || resolved="$candidate"
    [ "$resolved" = "$self" ] && continue
    found="$candidate"
  done <<CANDIDATES
$candidate_list
CANDIDATES
fi

if [ -n "$found" ]; then
  exec "$found" "$@"
fi

{
  echo "wiki: the Ymir wiki CLI is not installed on this machine."
  echo "Looked in:$searched"
  echo "  \$HOME/.claude/plugins/cache/ymir/ymir/<version>/wiki-cli/bin/wiki"
  echo "Install it with:  npx skills@latest add muitneliss/ymir"
  echo "Or point at an existing binary:  YMIR_WIKI_BIN=/path/to/wiki $0 $*"
} >&2
exit 127
